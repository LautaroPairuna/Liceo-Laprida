{
  "$schema": "https://schema.railpack.com",
  // Node sale de "engines" del package.json; el build, del script de la raiz:
  // arma el API (empaquetado en dist/bundle) y el sitio (standalone).
  "steps": {
    "build": {
      "commands": [
        "...",
        "cp -r apps/web/.next/static apps/web/.next/standalone/apps/web/.next/static",
        "cp -r apps/web/public apps/web/.next/standalone/apps/web/public",
        "rm -f apps/web/.next/standalone/.env* apps/web/.next/standalone/apps/web/.env*",
        "test -f apps/web/.next/standalone/apps/web/server.js",
        "test -f apps/api/dist/bundle/main.mjs",
        "test -f apps/api/prisma/seed-data.json"
      ]
    }
  },
  "deploy": {
    // Solo Node y lo compilado: ni node_modules de la raiz ni el codigo. El
    // standalone trae su propio node_modules con lo que usa el sitio, y el API
    // tiene sus dependencias adentro de dist/bundle.
    "inputs": [
      {
        "step": "packages:mise",
        "include": [
          "/mise/shims",
          "/mise/installs",
          "/usr/local/bin/mise",
          "/etc/mise/config.toml",
          "/root/.local/state/mise"
        ]
      },
      {
        "step": "build",
        "include": [
          "apps/web/.next/standalone",
          "apps/api/dist/bundle",
          "apps/api/prisma/seed-data.json",
          "scripts/arrancar.sh"
        ]
      }
    ],
    "startCommand": "exec bash scripts/arrancar.sh",
    "variables": {
      // El server standalone de Next escucha en HOSTNAME, y dentro de Docker esa
      // variable trae el nombre del contenedor.
      "HOSTNAME": "0.0.0.0",
      // Para los dos procesos. Va aca y no en el Environment del servicio para que
      // no le llegue al build: `next build` necesita bastante mas.
      "NODE_OPTIONS": "--max-old-space-size=384 --max-semi-space-size=4",
      // Que sharp no fragmente la memoria con las arenas de glibc.
      "MALLOC_ARENA_MAX": "2"
    }
  }
}
