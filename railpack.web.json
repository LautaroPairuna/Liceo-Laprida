{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "build": {
      "commands": [
        "npm run build -w web",
        "cp -r apps/web/.next/static apps/web/.next/standalone/apps/web/.next/static",
        "cp -r apps/web/public apps/web/.next/standalone/apps/web/public"
      ]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "packages:mise",
        "include": [
          "/mise/shims",
          "/mise/installs",
          "/usr/local/bin/mise",
          "/etc/mise/config.toml",
          "/root/.local/state/mise"
        ]
      },
      { "step": "build", "include": ["apps/web/.next/standalone"] }
    ],
    "startCommand": "node --max-old-space-size=384 apps/web/.next/standalone/apps/web/server.js",
    "variables": { "HOSTNAME": "0.0.0.0", "MALLOC_ARENA_MAX": "2" }
  }
}
