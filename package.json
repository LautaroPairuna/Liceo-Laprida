{
  "name": "liceo-laprida",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run start:dev -w api",
    "build": "npm run build -w api && npm run build -w web",
    "test": "npm test -w api",
    "lint": "biome check",
    "format": "biome format --write",
    "start": "bash scripts/arrancar.sh"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true,
    "msgpackr-extract": false,
    "fsevents": false
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "concurrently": "^9.2.5"
  }
}
