{
  "name": "liceo-laprida",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run start:dev -w api",
    "build": "npm run build -w api && npm run build -w web",
    "test": "npm test -w api",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
