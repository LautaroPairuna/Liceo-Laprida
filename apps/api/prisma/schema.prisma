generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum CourseFormat {
  presencial
  hibrido
  virtual
}

enum EnrollmentStatus {
  nuevo
  contactado
  inscripto
  baja
}

enum PaymentStatus {
  pendiente
  sena
  aprobado
  rechazado
}

enum AccessStatus {
  no_solicitado
  pendiente
  otorgado
  fallido
}

enum EnrollmentSource {
  web
  equipo
  ejemplo
}

/// formats, requirements, outcomes and modules are JSON string arrays (MySQL has no array columns); validated with Zod in the API.
model Course {
  id             String       @id @db.VarChar(120)
  title          String       @db.VarChar(200)
  category       String       @db.VarChar(60)
  durationMonths Int
  hours          Int
  formats        Json
  ministry       Boolean      @default(false)
  practices      Boolean      @default(false)
  seats          Int
  shift          String       @db.VarChar(60)
  matricula      Int
  cuota          Int
  requirements   Json
  start          DateTime     @db.Date
  image          String       @db.VarChar(500)
  summary        String       @db.Text
  description    String       @db.Text
  outcomes       Json
  modules        Json
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  enrollments    Enrollment[]

  @@index([category])
}

/// Editable site blocks (hero, story, contact, offers...), one row per block, edited whole from the admin.
model SiteContent {
  key       String   @id @db.VarChar(60)
  value     Json
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id          String           @id @default(cuid())
  code        String           @db.VarChar(20)
  name        String           @db.VarChar(200)
  dni         String           @db.VarChar(15)
  email       String           @db.VarChar(254)
  phone       String           @db.VarChar(40)
  courseId    String?          @db.VarChar(120)
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseTitle String           @db.VarChar(200)
  modality    CourseFormat
  shift       String           @db.VarChar(60)
  status      EnrollmentStatus @default(nuevo)
  payment     PaymentStatus    @default(pendiente)
  amount      Int
  notes       String           @db.Text
  source      EnrollmentSource @default(web)
  mpOrderId   String?          @unique @db.VarChar(64)
  mpStatus    String?          @db.VarChar(40)
  paidAt      DateTime?
  access      AccessStatus     @default(no_solicitado)
  accessNote  String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([createdAt])
  @@index([courseId])
  @@index([dni])
}

model User {
  id            String    @id @db.VarChar(64)
  name          String    @db.VarChar(200)
  email         String    @unique @db.VarChar(254)
  emailVerified Boolean   @default(false)
  image         String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @db.VarChar(64)
  expiresAt DateTime
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.Text
  userId    String   @db.VarChar(64)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @db.VarChar(64)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(64)
  userId                String    @db.VarChar(64)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @db.VarChar(64)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
